  "lyrics": [
    {
      "time": 0.0,
      "text": "从你说爱我以后，我的天空星星都亮了"
    },
    {
      "time": 15000.0,
      "text": "我愿变成童话里，你爱的那个天使"
    },
    {
      "time": 27352.941176470587,
      "text": "张开双手，变成翅膀守护你"
    },
    {
      "time": 33529.41176470588,
      "text": "你要相信，我们会像童话故事里"
    },
    {
      "time": 46764.705882352944,
      "text": "幸福和快乐是结局"
    }
  ]
