  "lyrics": [
    {
      "time": 0.0,
      "text": "总是向你索取，却不曾说谢谢你"
    },
    {
      "time": 12631.578947368422,
      "text": "直到长大以后，才懂得你不容易"
    },
    {
      "time": 25263.157894736843,
      "text": "时光时光慢些吧，不要再让你变老了"
    },
    {
      "time": 37894.73684210526,
      "text": "我愿用我一切，换你岁月长留"
    }
  ]
