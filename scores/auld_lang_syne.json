  "lyrics": [
    {
      "time": 714.2857142857143,
      "text": "怎能忘记旧日朋友，心中能不怀想"
    },
    {
      "time": 12142.857142857143,
      "text": "旧日朋友岂能相忘，友谊地久天长"
    },
    {
      "time": 23571.428571428572,
      "text": "我们曾经终日游荡，在故乡的青山上"
    },
    {
      "time": 35000.0,
      "text": "我们也曾历尽苦辛，到处奔波流浪"
    },
    {
      "time": 49285.71428571428,
      "text": "友谊万岁，友谊地久天长"
    }
  ]
