  "lyrics": [
    {
      "time": 0.0,
      "text": "这一路上走走停停，顺着少年漂流的痕迹"
    },
    {
      "time": 12800.0,
      "text": "迈出车站的前一刻，竟有些犹豫"
    },
    {
      "time": 26400.0,
      "text": "我曾难自拔于世界之大，也沉溺于其中梦话"
    },
    {
      "time": 39200.0,
      "text": "不得真假，不做挣扎，不惧笑话"
    }
  ]
